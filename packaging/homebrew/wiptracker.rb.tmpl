# Homebrew formula for the paxel/tap tap — generated by the release workflow, which
# fills in the tagged version and the sha256 of each release tarball and pushes the
# result to the homebrew-tap repository as Formula/wiptracker.rb.
# Binary formula: it installs the prebuilt `wiptracker`.
class Wiptracker < Formula
  desc "One-line always-on-top bar showing the task you are focused on right now"
  homepage "https://github.com/paxel/wipTracker"
  version "{{VERSION}}"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/paxel/wipTracker/releases/download/v{{VERSION}}/wiptracker-{{VERSION}}-macos-arm64.tar.gz"
      sha256 "{{SHA_MACOS_ARM64}}"
    else
      url "https://github.com/paxel/wipTracker/releases/download/v{{VERSION}}/wiptracker-{{VERSION}}-macos-x86_64.tar.gz"
      sha256 "{{SHA_MACOS_X86_64}}"
    end
  end

  on_linux do
    url "https://github.com/paxel/wipTracker/releases/download/v{{VERSION}}/wiptracker-{{VERSION}}-linux-x86_64.tar.gz"
    sha256 "{{SHA_LINUX_X86_64}}"
  end

  def install
    bin.install "wiptracker"
    # On Linux the desktop entry and the icon are what give the window a taskbar icon:
    # Wayland has no protocol for a client to set its own, so the compositor matches the
    # window's app_id to wiptracker.desktop instead.
    return unless OS.linux?

    # Absolute paths, not bare names. A desktop session does not read Homebrew's shell
    # environment, so neither its bin directory nor its icon theme directory is on the
    # session's PATH or XDG_DATA_DIRS: "Exec=wiptracker" would fail to launch and
    # "Icon=wiptracker" would find nothing to draw.
    icon = "#{opt_prefix}/share/icons/hicolor/256x256/apps/wiptracker.png"
    inreplace "wiptracker.desktop" do |entry|
      entry.gsub! "Exec=wiptracker", "Exec=#{opt_bin}/wiptracker"
      entry.gsub! "Icon=wiptracker", "Icon=#{icon}"
    end

    # The installer and everything it copies live together, so it finds the icons next to
    # itself. A wrapper rather than a symlink, for the same reason.
    libexec.install "install-icon.sh", "wiptracker.desktop"
    libexec.install Dir["icon*.png"]
    (bin/"wiptracker-install-icon").write <<~SH
      #!/bin/sh
      exec "#{opt_libexec}/install-icon.sh" "$@"
    SH
    (bin/"wiptracker-install-icon").chmod 0755

    # Also in Homebrew's own share, for the sessions that do read it.
    (share/"applications").mkpath
    cp libexec/"wiptracker.desktop", share/"applications/wiptracker.desktop"
    [32, 48, 64, 128, 256, 512].each do |size|
      source = size == 512 ? libexec/"icon.png" : libexec/"icon-#{size}.png"
      next unless source.exist?

      directory = share/"icons/hicolor/#{size}x#{size}/apps"
      directory.mkpath
      cp source, directory/"wiptracker.png"
    end
  end

  def caveats
    return <<~EOS unless OS.linux?
      WipTracker is a desktop bar, not a command-line tool: run `wiptracker` from a
      graphical session. The macOS release also ships WipTracker.app for the Dock;
      download the .dmg from the GitHub release page if you prefer that.
    EOS

    <<~EOS
      WipTracker is a desktop bar, not a command-line tool: run `wiptracker` from a
      graphical session.

      To get it into your application menu, where it can also be pinned, run once:

        wiptracker-install-icon

      That copies the launcher entry and the icons into ~/.local/share, which every
      desktop session reads. Homebrew's own share directory is not on a session's
      XDG_DATA_DIRS, so an entry installed there alone stays invisible to menus. Add
      --autostart to the same command to start WipTracker with your session.

      Without XWayland the bar cannot stay on top and starts with a window frame, because
      Wayland has no protocol for either; use your compositor's own "keep above" rule.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/wiptracker --version")
  end
end
